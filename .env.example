# Copy to .env and adjust locally. Never commit .env.
# No secrets are required to run this project.

# Path to the YAML configuration (relative to the repo root).
BNA_CONFIG_PATH=configs/config.yaml

# Logging level for the banknextaction package (DEBUG, INFO, WARNING, ERROR).
BNA_LOG_LEVEL=INFO

# Port used by the API when running locally.
BNA_PORT=8000
